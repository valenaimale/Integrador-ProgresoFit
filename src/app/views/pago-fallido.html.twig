{% extends 'base.html.twig' %}

{% block title %}Pago fallido — ProgresoFit{% endblock %}

{% block styles %}
<style>
    .pago-resultado {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        padding: 80px 20px;
        min-height: 50vh;
    }
    .icono-error {
        width: 80px;
        height: 80px;
        border-radius: 50%;
        background: #e74c3c;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 30px;
    }
    .icono-error svg {
        width: 40px;
        height: 40px;
        fill: #fff;
    }
    .pago-resultado h1 {
        font-family: var(--font-titulo);
        font-size: 2rem;
        margin-bottom: 15px;
        color: var(--negro);
    }
    .pago-resultado p {
        font-size: 1.1rem;
        color: #666;
        margin-bottom: 40px;
    }
    .acciones-pago {
        display: flex;
        gap: 15px;
        flex-wrap: wrap;
        justify-content: center;
    }
    .btn-secundario {
        display: inline-block;
        padding: 15px 30px;
        border: 2px solid var(--rojo);
        color: var(--rojo);
        border-radius: var(--radio);
        font-weight: 700;
        text-decoration: none;
        transition: all 0.3s ease;
    }
    .btn-secundario:hover {
        background: var(--rojo);
        color: #fff;
    }
</style>
{% endblock %}

{% block content %}
<div class="pago-resultado">
    <div class="icono-error">
        <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/>
        </svg>
    </div>
    <h1>El pago no pudo procesarse</h1>
    <p>Podés intentarlo de nuevo.</p>
    <div class="acciones-pago">
        <a href="/pago-suscripcion" class="btn-primario">Reintentar</a>
        <a href="/perfil" class="btn-secundario">Ir a mi perfil</a>
    </div>
</div>
{% endblock %}
