{% extends 'base.html.twig' %}

{% block title %}ProgresoFit — Pagos y Suscripción{% endblock %}

{% block styles %}
<link rel="stylesheet" href="/assets/css/formularios.css">
<link rel="stylesheet" href="/assets/css/perfil.css">
<style>
    .planes-seleccion {
        display: flex;
        flex-direction: column;
        gap: 15px;
        margin-bottom: 20px;
    }
    .card-plan {
        display: flex;
        align-items: flex-start;
        gap: 15px;
        padding: 15px;
        border: 2px solid var(--crema-dark);
        border-radius: var(--radio);
        cursor: pointer;
        transition: all 0.3s ease;
    }
    .card-plan:hover {
        border-color: var(--rojo);
    }
    .card-plan input[type="radio"] {
        margin-top: 5px;
        width: auto;
    }
    .card-plan input[type="radio"]:checked + .plan-info h3 {
        color: var(--rojo);
    }
    .plan-info h3 {
        margin: 0 0 5px 0;
        font-family: var(--font-titulo);
        text-transform: uppercase;
    }
    .plan-info .precio {
        font-weight: 800;
        font-size: 1.2rem;
        margin-bottom: 10px;
    }
    .plan-info ul {
        margin: 0;
        padding-left: 20px;
        font-size: 0.9rem;
    }
</style>
{% endblock %}

{% block content %}
<h2>Seleccioná tu plan de suscripción</h2>

{% if error %}
    <p class="error-msg">{{ error }}</p>
{% endif %}
{% if mensaje %}
    <p class="exito">{{ mensaje }}</p>
{% endif %}

<div class="perfil-grid">
    <form action="/pago-suscripcion" method="post" style="display: contents;">
        <aside class="info-lista">
            <h2>Planes disponibles</h2>
            <div class="planes-seleccion">
                {% for plan in planes %}
                    <label class="card-plan">
                        <input type="radio" name="plan" value="{{ plan.nombre }}" required>
                        <div class="plan-info">
                            <h3>{{ plan.nombre|upper }}</h3>
                            <p class="precio">${{ plan.precio|number_format(0, ',', '.') }} / mes</p>
                            <ul>
                                <li>Acceso ilimitado a rutinas</li>
                                <li>Seguimiento de progreso</li>
                                {% if plan.nombre == 'premium' %}
                                    <li>Asesoramiento personalizado</li>
                                {% elseif plan.nombre == 'elite' %}
                                    <li>Asesoramiento personalizado</li>
                                    <li>Acceso a eventos exclusivos</li>
                                {% endif %}
                            </ul>
                        </div>
                    </label>
                {% endfor %}
            </div>
        </aside>

        <section class="info-lista">
            <fieldset>
                <legend>Datos de facturación (Simulado)</legend>
                <label for="nombre-titular">Nombre del titular</label>
                <input type="text" id="nombre-titular" name="nombre-titular" placeholder="Tal como aparece en la tarjeta" required>

                <label for="numero-tarjeta">Número de tarjeta</label>
                <input type="text" id="numero-tarjeta" name="numero-tarjeta" placeholder="XXXX XXXX XXXX XXXX" required>

                <div class="form-acciones" style="flex-direction: row; gap: 20px;">
                    <div style="flex: 1;">
                        <label for="cvv">CVV</label>
                        <input type="text" id="cvv" name="cvv" placeholder="123" required style="width: 100%;">
                    </div>
                    <div style="flex: 1;">
                        <label for="fecha_ven">Vencimiento</label>
                        <input type="month" id="fecha_ven" name="fecha_ven" required style="width: 100%;">
                    </div>
                </div>
            </fieldset>
            <div class="form-acciones" style="margin-top: 30px;">
                <button type="submit" class="btn-primario" style="width: 100%; padding: 15px;">Confirmar Suscripción</button>
            </div>
        </section>
    </form>
</div>
{% endblock %}
