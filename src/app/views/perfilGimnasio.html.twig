{% extends 'base.html.twig' %}

{% block title %}{{ gimnasio ? gimnasio.nombre : 'Perfil del Gimnasio' }} — ProgresoFit{% endblock %}

{% block styles %}
<link rel="stylesheet" href="/assets/css/perfil.css">
{% endblock %}

{% block content %}
{% set gym = gimnasio ?? userData ?? null %}
{% if gym is null %}
    <p class="text-muted">No se encontró el gimnasio.</p>
{% else %}
    <div class="perfil-grid">
        <section class="perfil-hero">
            <figure>
                <img src="{{ gym.foto_url ?? '/assets/img/imagenUser.jpg' }}" alt="Foto del gimnasio">
            </figure>
        </section>

        <section class="info-lista">
            <dl>
                <dt>Nombre</dt>
                <dd>{{ gym.nombre }}</dd>

                {% if gym.direccion %}
                    <dt>Dirección</dt>
                    <dd>{{ gym.direccion }}</dd>
                {% endif %}

                {% if gym.descripcion %}
                    <dt>Descripción</dt>
                    <dd class="dd-descripcion">{{ gym.descripcion }}</dd>
                {% endif %}

                {% if gym.servicios %}
                    <dt>Servicios</dt>
                    <dd class="dd-descripcion">{{ gym.servicios }}</dd>
                {% endif %}

                {% if gym.horarios %}
                    <dt>Horarios</dt>
                    <dd>{{ gym.horarios }}</dd>
                {% endif %}

                {% if gym.telefono %}
                    <dt>Teléfono</dt>
                    <dd>{{ gym.telefono }}</dd>
                {% endif %}
            </dl>

            {% if aforo %}
                <div class="aforo-inline aforo-{{ estado }}">
                    <span class="aforo-label">Ocupación actual</span>
                    <div class="aforo-numeros">
                        <strong>{{ aforo.ocupacion_actual }}</strong> / {{ aforo.capacidad_maxima }} personas
                    </div>
                    <div class="aforo-barra-wrap">
                        <div class="aforo-barra" style="width: {{ porcentaje }}%"></div>
                    </div>
                    <span class="aforo-pct">{{ porcentaje }}% de ocupación</span>
                </div>
            {% endif %}

            <a href="/gimnasios" class="btn btn-outline">← Volver a gimnasios</a>
        </section>
    </div>
{% endif %}
{% endblock %}
