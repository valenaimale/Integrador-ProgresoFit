{% extends 'base.html.twig' %}

{% block title %}Rutinas — ProgresoFit{% endblock %}

{% block styles %}
<link rel="stylesheet" href="/assets/css/rutinas.css">
{% endblock %}

{% block content %}
<section class="seccion-rutinas">
    {% if session.user.rol in ['ENTRENADOR', 'ADMIN'] %}
        <h2>Gestión de Rutinas</h2>
    {% else %}
        <h2>Elige tu programa según tu objetivo</h2>
    {% endif %}

    {% if mensaje %}
        <p class="exito">{{ mensaje }}</p>
    {% endif %}
    {% if error %}
        <p class="error">{{ error }}</p>
    {% endif %}

    {% if not rutinas %}
        <p class="sin-resultados">No hay rutinas disponibles.</p>
    {% else %}
        <ul class="grid-rutinas">
            {% for rutina in rutinas %}
                <li class="card-rutina-container">
                    <a href="/rutina?id={{ rutina.id }}" class="card-rutina">
                        <article>
                            <h3>{{ rutina.titulo }}</h3>
                            <div class="card-info">
                                <span class="card-autor">{{ rutina.entrenador_nombre|default('Entrenador') }}</span>
                                {% if rutina.descripcion %}
                                    <p class="card-descripcion">{{ rutina.descripcion }}</p>
                                {% endif %}
                                {% if rutina.objetivo %}
                                    <span class="card-objetivo">Objetivo: {{ rutina.objetivo }}</span>
                                {% endif %}
                            </div>
                        </article>
                    </a>

                    {% if session.user.rol in ['ENTRENADOR', 'ADMIN'] %}
                        <div class="admin-actions">
                            <form action="/rutinas/asignar" method="post" class="form-asignar">
                                <input type="hidden" name="rutina_id" value="{{ rutina.id }}">
                                <select name="alumno_id" required>
                                    <option value="">Asignar a alumno...</option>
                                    {% for alumno in alumnos %}
                                        <option value="{{ alumno.id }}">{{ alumno.nombre }} ({{ alumno.email }})</option>       
                                    {% endfor %}
                                </select>
                                <button type="submit" class="btn-asignar">Asignar</button>
                            </form>
                        </div>
                    {% endif %}
                </li>
            {% endfor %}
        </ul>
    {% endif %}
</section>

<section class="seccion-especial">
    <h2>Programas especiales de 28 días</h2>
    <ul class="grid-programas">
        <li>
            <a href="/autocuidado" class="card-programa">
                <article>
                    <h3>Autocuidado</h3>
                    <p>Las mejores rutinas para el cuidado personal</p>
                </article>
            </a>
        </li>
        <li>
            <a href="/principiante" class="card-programa">
                <article>
                    <h3>Principiante</h3>
                    <p>Tenés que ver esto si estás comenzando a entrenarte</p>
                </article>
            </a>
        </li>
    </ul>
</section>
{% endblock %}
