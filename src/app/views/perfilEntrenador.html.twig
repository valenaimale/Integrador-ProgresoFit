{% extends 'base.html.twig' %}

{% block title %}Perfil del entrenador — ProgresoFit{% endblock %}

{% block styles %}
<link rel="stylesheet" href="/assets/css/perfil.css">
{% endblock %}

{% block content %}
{% if userData is not defined or userData is null %}
    <p class="text-muted">No se encontró el entrenador.</p>
{% else %}
<div class="perfil-grid">
    <section class="perfil-hero">
        <figure>
            <img src="{{ userData.foto_url ?? '/assets/img/imagenUser.jpg' }}" alt="Foto del entrenador">
        </figure>
    </section>

    <section class="info-lista">
        <dl>
            <dt>Nombre</dt>
            <dd>{{ userData.nombre ?? 'Sin nombre' }}</dd>

            <dt>Email</dt>
            <dd><a href="mailto:{{ userData.email }}">{{ userData.email }}</a></dd>

            {% if userData.especialidad %}
                <dt>Especialidad</dt>
                <dd>{{ userData.especialidad }}</dd>
            {% endif %}

            {% if userData.descripcion %}
                <dt>Descripción</dt>
                <dd class="dd-descripcion">{{ userData.descripcion }}</dd>
            {% endif %}

            {% if userData.horario %}
                <dt>Horarios</dt>
                <dd>{{ userData.horario }}</dd>
            {% endif %}
        </dl>

        <a href="/editar-perfil" class="btn btn-outline">Editar perfil</a>
    </section>
</div>
{% endif %}
{% endblock %}
